VITE_API_URL=https://api.hoopla.uz/api/v1

# Sends X-Hoopla-Test: true on every request, revealing type='test' partners/
# shops/orders that are otherwise hidden from real customers. Set to "true"
# only while testing against a test partner — never in a build real
# customers use.
VITE_HOOPLA_TEST_MODE=false