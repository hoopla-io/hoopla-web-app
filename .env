VITE_API_URL=https://api.hoopla.uz/v2

# Sends X-Hoopla-Test: true on every request, revealing type='test' partners/
# shops/orders that are otherwise hidden from real customers. Set to "true"
# only while testing against a test partner — never in a build real
# customers use.
VITE_HOOPLA_TEST_MODE=false

# Which host platform this bundle is built for. Empty = the public web app.
# `.env.anor` sets it to "eight" for anor.hoopla.uz. Must stay declared (even
# empty) so Vite inlines it as a literal and drops the miniapp code from this
# build instead of leaving it reachable at runtime.
VITE_HOST_PLATFORM=
