# Build config for the Anor (Eight miniapp) bundle served from anor.hoopla.uz.
# Layered on top of .env by `vite build --mode anor` (npm run build:anor).
#
# VITE_HOST_PLATFORM=eight is what compiles in src/helpers/eight.ts: the launch-
# token capture, the host-session auth rules and the native payment bridge. The
# default (public) build leaves it unset, so none of that code ships to
# web.hoopla.uz — see the SECURITY note in src/helpers/eight.ts.
VITE_HOST_PLATFORM=eight

VITE_API_URL=https://api.hoopla.uz/api/v1
VITE_HOOPLA_TEST_MODE=false
